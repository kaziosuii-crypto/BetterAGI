# DeepSeek + OpenViking 导演环境（示例）
# 复制为环境变量或 source 本文件；不要提交真实密钥。

LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash
# DeepSeek 是推理模型：4096 给思考 + JSON 留空间；低思考预算降低延迟
LLM_MAX_TOKENS=4096
OPENAI_REASONING_EFFORT=low

# OpenViking 长期记忆（可选，未启动时自动降级）
OPENVIKING_ENABLED=1
OPENVIKING_URL=http://127.0.0.1:1933
# 资源/记忆子树
OPENVIKING_LORE_URI=viking://~/resources/genshin
OPENVIKING_MEMORY_URI=viking://~/memories/genshin
OPENVIKING_RECALL_LIMIT=4
OPENVIKING_WRITE_INTERVAL_S=60
